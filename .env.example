# ── TypeRacer Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server port (default: 3000)
PORT=3000

# Node environment: "development" or "production"
NODE_ENV=development

# Exact HTTPS origin required in production, without a path or trailing slash.
# Example: https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:3000

# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave blank for direct access.
# Example for a same-machine proxy: 127.0.0.1/32,::1/128
# Only enable this when Node is reachable exclusively through these proxies.
TRUSTED_PROXIES=

# Groq API key for AI-generated quotes and analysis.
# Get one free at https://console.groq.com
# Leave blank to use the built-in static quote library.
GROQ_API_KEY=

# Groq model used for both passages and coaching.
GROQ_MODEL=openai/gpt-oss-20b
